@page "/"
@implements IDisposable
@inject DistillForgeApi Api
@inject IJSRuntime JS
@inject AiSettingsState AiState

<PageTitle>DistillForge</PageTitle>

@if (_error is not null)
{
    <div class="banner-error" role="alert">
        <span>@_error</span>
        <button type="button" class="link" @onclick="() => _error = null">Dismiss</button>
    </div>
}

<div class="workspace">
    <section class="panel source-panel" aria-label="Source">
        <div class="workspace-bar">
            <select aria-label="Workspace" @onchange="OnWorkspaceChosen" disabled="@(IsExtracting || _saving)">
                @if (_workspace is null)
                {
                    <option value="" selected>@(_list.Count == 0 ? "No workspaces" : "Select a workspace…")</option>
                }
                @foreach (var w in _list)
                {
                    <option value="@w.Id" selected="@(w.Id == _workspace?.Id)">@(w.IsArchived ? "📦 " : "")@w.Title (@w.ActionItemCount) · @w.UpdatedAt.ToLocalTime().ToString("d MMM HH:mm")</option>
                }
            </select>
            <button type="button" class="secondary" @onclick="OpenNew" disabled="@(IsExtracting || _saving)" title="Start a new workspace">+ New</button>
            @if (_workspace is not null)
            {
                <button type="button" class="secondary" @onclick="ToggleArchive" disabled="@(IsExtracting || _saving)"
                        title="@(_workspace.IsArchived ? "Restore this workspace to the active list" : "Hide this workspace from the active list")">
                    @(_workspace.IsArchived ? "Unarchive" : "Archive")
                </button>
            }
            <label class="show-archived">
                <input type="checkbox" checked="@_showArchived" @onchange="OnShowArchivedChanged" /> Show archived
            </label>
        </div>
        <header class="panel-header">
            <h2>@(_workspace?.Title ?? "Source")</h2>
            @if (_workspace is not null)
            {
                <span class="muted">@(_workspace.IsArchived ? "Archived · " : "")@_workspace.Strategy · @_workspace.Segments.Count segments</span>
            }
        </header>

        @if (_loading)
        {
            <p class="muted pad">Loading…</p>
        }
        else if (_workspace is null)
        {
            <p class="muted pad">@(_list.Count == 0 ? "No source yet. Add a document to extract action points." : "Pick a workspace above, or start a new one.")</p>
        }
        else
        {
            <SourcePane Text="@_workspace.SourceText" Highlights="_highlights" />
        }

        <footer class="panel-footer">
            @if (_workspace is null)
            {
                <button type="button" class="add-source" @onclick="OpenNew" disabled="@IsExtracting">Add Source</button>
            }
            else if (_workspace.IsArchived)
            {
                <span class="muted archived-note">Archived workspaces are read-only. Unarchive to re-extract or replace the source.</span>
            }
            else
            {
                <button type="button" class="add-source" @onclick="OpenReplace" disabled="@IsExtracting">Replace Source</button>
                <select class="model-picker" aria-label="AI model for extraction" title="Model used for the next extraction"
                        @bind="ChosenModel" disabled="@IsExtracting">
                    <option value="">@DefaultModelLabel</option>
                    @foreach (var m in _models)
                    {
                        <option value="@m.Id">@m.Label</option>
                    }
                </select>
                <button type="button" class="secondary" @onclick="ConfirmReextract" disabled="@IsExtracting">Re-extract</button>
            }
        </footer>
    </section>

    <div class="right-column">
        <section class="panel notes-panel @(_dropTarget == UncategorisedTarget ? "drop-over" : "")" aria-label="Uncategorised action items"
                 @ondragover="() => OnDragOverTarget(UncategorisedTarget)" @ondragover:preventDefault="@(_dragId is not null)"
                 @ondragleave="() => ClearDropTarget(UncategorisedTarget)"
                 @ondrop="() => DropOn(null)" @ondrop:preventDefault="true">
            <header class="panel-header">
                <h2>Uncategorised</h2>
                @if (IsExtracting)
                {
                    <button type="button" class="status running as-button" @onclick="() => _progressHidden = false" title="Show progress">@ProgressText</button>
                }
                else if (_run?.Status == ExtractionRunStatus.Cancelled)
                {
                    <span class="status">Extraction cancelled</span>
                }
                else if (_run?.Status == ExtractionRunStatus.Failed)
                {
                    <span class="status failed" title="@_run.Error">Extraction failed: @_run.Error</span>
                }
                else if (_run?.Status == ExtractionRunStatus.Succeeded)
                {
                    <span class="status ok" title="@_run.Warnings">
                        @_run.ActionItemCount found@(string.IsNullOrEmpty(_run.Model) ? "" : $" · {_run.Model}")@(_run.PromptTokens is int p ? $" · {p:N0} prompt tokens" : "")@(string.IsNullOrEmpty(_run.Warnings) ? "" : " · warnings")
                    </span>
                }
            </header>
            @if (_actions.Count > 0)
            {
                <div class="filter-bar" role="search" aria-label="Filter action items">
                    <label>
                        Party
                        <select @bind="OwnerFilter">
                            <option value="">All (@_actions.Count)</option>
                            @foreach (var (name, count) in Owners)
                            {
                                <option value="@name">@name (@count)</option>
                            }
                            @if (_actions.Any(a => string.IsNullOrWhiteSpace(a.Owner)))
                            {
                                <option value="@Unassigned">Unassigned (@_actions.Count(a => string.IsNullOrWhiteSpace(a.Owner)))</option>
                            }
                        </select>
                    </label>
                    <label>
                        Deadline
                        <select @bind="DueFilter">
                            <option value="">Any</option>
                            <option value="with">With deadline (@_actions.Count(HasDue))</option>
                            <option value="without">No deadline (@_actions.Count(a => !HasDue(a)))</option>
                        </select>
                    </label>
                    <label>
                        Duplicates
                        <select @bind="DupFilter">
                            <option value="">Any</option>
                            <option value="only">Possible duplicates (@_actions.Count(IsPossibleDup))</option>
                        </select>
                    </label>
                    <span class="swatch-key" title="Notes with a deadline are yellow"><span class="swatch"></span>deadline</span>
                    @if (FiltersActive)
                    {
                        <button type="button" class="link" @onclick="ResetFilters">Clear filters</button>
                    }
                    <span class="muted filter-count">Showing @VisibleUncategorised.Count of @_actions.Count(a => a.CategoryId is null)</span>
                </div>
            }
            <div class="notes-grid">
                @foreach (var item in VisibleUncategorised)
                {
                    <StickyNote Item="item" Selected="item.Id == _selectedId" OnClick="() => Select(item)" OnZoom="() => OpenItem(item)"
                                Draggable="CanEdit" Dragging="_dragId == item.Id" OnDragStart="() => StartDrag(item)" OnDragEnd="EndDrag"
                                PossibleDuplicate="IsPossibleDup(item)" MergedCount="MergedCountOf(item)"
                                Droppable="CanDropOn(item)" MergeTarget="_mergeHover == item.Id"
                                OnDragEnterNote="() => NoteDragEnter(item)" OnDragLeaveNote="() => NoteDragLeave(item)" OnDropNote="() => DropOnNote(item)" />
                }
                @if (!IsExtracting && _workspace is not null && _actions.Count == 0)
                {
                    <p class="muted">No action items yet.</p>
                }
                else if (_actions.Count > 0 && VisibleUncategorised.Count == 0)
                {
                    <p class="muted">No notes match the current filters.</p>
                }
            </div>
        </section>

        <section class="panel categories-panel @(_dropTarget == BodyTarget ? "drop-over" : "")" aria-label="Categories">
            <nav class="category-tabs" aria-label="Categories" role="tablist">
                @foreach (var c in _categories)
                {
                    var active = c.Id == ActiveCategory?.Id;
                    <button type="button" role="tab" aria-selected="@active"
                            class="tab @(active ? "active" : "") @(_dropTarget == c.Id.ToString() ? "drop-over" : "")"
                            style="--tab-accent: @AccentVar(c)"
                            @onclick="() => _activeCategoryId = c.Id"
                            @ondblclick="() => OpenCategoryEdit(c)"
                            @ondragover="() => OnDragOverTarget(c.Id.ToString())" @ondragover:preventDefault="@(_dragId is not null)"
                            @ondragenter="() => OnDragOverTarget(c.Id.ToString())"
                            @ondragleave="() => ClearDropTarget(c.Id.ToString())"
                            @ondrop="() => DropOn(c.Id)" @ondrop:preventDefault="true"
                            title="Double-click to edit">
                        @c.Name <span class="tab-count">@CountIn(c)</span>
                    </button>
                }
                @if (_categories.Count == 0)
                {
                    <span class="tab placeholder">No categories yet</span>
                }
                <span class="tab-spacer"></span>
                @if (CanEdit)
                {
                    <button type="button" class="icon-button" title="Add category" aria-label="Add category" @onclick="OpenCategoryNew">＋</button>
                    @if (ActiveCategory is not null)
                    {
                        <button type="button" class="icon-button" title="Edit category" aria-label="Edit category" @onclick="() => OpenCategoryEdit(ActiveCategory)">✎</button>
                        <button type="button" class="icon-button danger" title="Delete category" aria-label="Delete category" @onclick="() => DeleteCategory(ActiveCategory)">✕</button>
                    }
                }
            </nav>
            <div class="notes-grid category-body"
                 @ondragover="() => OnDragOverTarget(BodyTarget)" @ondragover:preventDefault="@(_dragId is not null && ActiveCategory is not null)"
                 @ondragleave="() => ClearDropTarget(BodyTarget)"
                 @ondrop="() => DropOn(ActiveCategory?.Id)" @ondrop:preventDefault="true">
                @if (ActiveCategory is null)
                {
                    <p class="muted empty-hint">@(_workspace is null ? "Open a workspace to add categories." : "Add a category with ＋, then drag notes onto it.")</p>
                }
                else
                {
                    @foreach (var item in InActive)
                    {
                        <StickyNote Item="item" Selected="item.Id == _selectedId" OnClick="() => Select(item)" OnZoom="() => OpenItem(item)"
                                    Draggable="CanEdit" Dragging="_dragId == item.Id" OnDragStart="() => StartDrag(item)" OnDragEnd="EndDrag"
                                    PossibleDuplicate="IsPossibleDup(item)" MergedCount="MergedCountOf(item)"
                                    Droppable="CanDropOn(item)" MergeTarget="_mergeHover == item.Id"
                                    OnDragEnterNote="() => NoteDragEnter(item)" OnDragLeaveNote="() => NoteDragLeave(item)" OnDropNote="() => DropOnNote(item)" />
                    }
                    @if (InActive.Count == 0)
                    {
                        <p class="muted empty-hint">Drag notes here to put them in “@ActiveCategory.Name”.</p>
                    }
                }
            </div>
        </section>
    </div>
</div>

@if (IsExtracting && !_progressHidden && _run is not null)
{
    <ExtractionProgressDialog Run="_run" Cancelling="_cancelling" OnHide="() => _progressHidden = true" OnCancel="CancelExtraction" />
}

@if (_editing is not null)
{
    <ActionItemDialog Item="_editing" ReadOnly="_workspace?.IsArchived == true" Busy="_editSaving" Error="@_editError"
                      Linked="LinkedFor(_editing)" Merged="MergedOf(_editing)" Categories="_categories"
                      OnMerge="MergeItems" OnUnmerge="UnmergeItem" OnNotDuplicate="DismissDuplicate"
                      OnSave="SaveItem" OnCancel="CloseItem" />
}

@if (_categoryDialog)
{
    <CategoryDialog Existing="_categoryEditing" Busy="_categorySaving" Error="@_categoryError" OnSave="SaveCategory" OnCancel="() => _categoryDialog = false" />
}

@if (_showDialog)
{
    <AddSourceDialog IsReplace="_replacing" Models="_models" ModelId="_chosenModelId" Busy="_saving" OnSubmit="SubmitSource" OnCancel="() => _showDialog = false" />
}

@code {
    private WorkspaceDto? _workspace;
    private List<ActionItemDto> _actions = [];  // top-level notes only (what the panels show)
    private List<ActionItemDto> _merged = [];   // notes merged into another; hidden, follow their parent

    private void ApplyActions(IEnumerable<ActionItemDto> all)
    {
        var list = all.ToList();
        _actions = list.Where(a => a.MergedIntoId is null).ToList();
        _merged = list.Where(a => a.MergedIntoId is not null).ToList();
        if (_selectedId is Guid sel && !_actions.Any(a => a.Id == sel)) ClearSelection();
    }

    private static bool IsPossibleDup(ActionItemDto a) => a.PossibleDuplicateIds is { Count: > 0 };
    private int MergedCountOf(ActionItemDto a) => _merged.Count(m => m.MergedIntoId == a.Id);
    private List<ActionItemDto> MergedOf(ActionItemDto a) => _merged.Where(m => m.MergedIntoId == a.Id).ToList();
    private List<ActionItemDto> LinkedFor(ActionItemDto a) =>
        _actions.Where(o => a.PossibleDuplicateIds?.Contains(o.Id) == true).ToList();
    private ExtractionRunDto? _run;
    private Guid? _selectedId;
    private IReadOnlyList<HighlightRange> _highlights = [];
    private List<WorkspaceSummaryDto> _list = [];
    private bool _showArchived, _replacing;
    private bool _loading = true, _saving, _showDialog, _scrollPending;
    private string? _error;
    private readonly CancellationTokenSource _cts = new();

    private bool _progressHidden, _cancelling;

    private async Task CancelExtraction()
    {
        if (_run is null || _cancelling) return;
        _cancelling = true;
        try { _run = await Api.CancelRunAsync(_run.Id, _cts.Token); }
        catch (ApiException ex) { _error = ex.Message; }
        catch (OperationCanceledException) { }
        finally { _cancelling = false; }
    }

    // ---- Categories ----
    private List<CategoryDto> _categories = [];
    private Guid? _activeCategoryId;
    private bool _categoryDialog, _categorySaving;
    private CategoryDto? _categoryEditing;
    private string? _categoryError;

    private bool CanEdit => _workspace is { IsArchived: false } && !IsExtracting;

    private CategoryDto? ActiveCategory => _categories.FirstOrDefault(c => c.Id == _activeCategoryId) ?? _categories.FirstOrDefault();
    private List<ActionItemDto> InActive => ActiveCategory is { } c ? _actions.Where(a => a.CategoryId == c.Id).ToList() : [];
    private int CountIn(CategoryDto c) => _actions.Count(a => a.CategoryId == c.Id);
    private static string AccentVar(CategoryDto c) => c.Colour is null ? "var(--border-strong)" : $"var(--note-{c.Colour})";

    private void OpenCategoryNew() { _categoryEditing = null; _categoryError = null; _categoryDialog = true; }
    private void OpenCategoryEdit(CategoryDto c) { if (!CanEdit) return; _categoryEditing = c; _categoryError = null; _categoryDialog = true; }

    private async Task SaveCategory(CategoryRequest request)
    {
        if (_workspace is null) return;
        _categorySaving = true;
        _categoryError = null;
        try
        {
            if (_categoryEditing is null)
            {
                var created = await Api.CreateCategoryAsync(_workspace.Id, request, _cts.Token);
                _categories.Add(created);
                _activeCategoryId = created.Id;
            }
            else
            {
                var saved = await Api.UpdateCategoryAsync(_categoryEditing.Id, request, _cts.Token);
                var i = _categories.FindIndex(c => c.Id == saved.Id);
                if (i >= 0) _categories[i] = saved;
            }
            _categoryDialog = false;
        }
        catch (ApiException ex) { _categoryError = ex.Message; }
        finally { _categorySaving = false; }
    }

    private async Task DeleteCategory(CategoryDto c)
    {
        var n = CountIn(c);
        var msg = n == 0 ? $"Delete category “{c.Name}”?" : $"Delete category “{c.Name}”? Its {n} note{(n == 1 ? "" : "s")} will return to Uncategorised.";
        if (!await JS.InvokeAsync<bool>("confirm", msg)) return;
        try
        {
            await Api.DeleteCategoryAsync(c.Id, _cts.Token);
            _categories.Remove(c);
            for (var i = 0; i < _actions.Count; i++)
                if (_actions[i].CategoryId == c.Id) _actions[i] = _actions[i] with { CategoryId = null };
            for (var i = 0; i < _merged.Count; i++)
                if (_merged[i].CategoryId == c.Id) _merged[i] = _merged[i] with { CategoryId = null };
            if (_activeCategoryId == c.Id) _activeCategoryId = null;
        }
        catch (ApiException ex) { _error = ex.Message; }
    }

    // ---- Drag and drop ----
    private const string UncategorisedTarget = "uncategorised";
    private const string BodyTarget = "body";
    private Guid? _dragId;
    private string? _dropTarget;

    private void StartDrag(ActionItemDto item) { if (CanEdit) _dragId = item.Id; }

    private void EndDrag() { _dragId = null; _dropTarget = null; _mergeHover = null; }

    // ---- Merging (drop a note onto another) ----
    private Guid? _mergeHover;

    private bool CanDropOn(ActionItemDto target) => CanEdit && _dragId is Guid d && d != target.Id;

    private void NoteDragEnter(ActionItemDto target) { if (CanDropOn(target)) _mergeHover = target.Id; }

    private void NoteDragLeave(ActionItemDto target) { if (_mergeHover == target.Id) _mergeHover = null; }

    private async Task DropOnNote(ActionItemDto target)
    {
        var id = _dragId;
        EndDrag(); // the dragged card may vanish after the merge, in which case dragend never fires
        if (id is null || id == target.Id || !CanEdit) return;
        var source = _actions.FirstOrDefault(a => a.Id == id);
        if (source is null) return;

        var carried = MergedCountOf(source);
        var msg = $"Merge “{source.Title}” into “{target.Title}”?\n\n" +
                  $"“{source.Title}” will be hidden and follow “{target.Title}”" +
                  (carried > 0 ? $", along with its {carried} merged note{(carried == 1 ? "" : "s")}" : "") +
                  $". You can unmerge it later from the details of “{target.Title}”.";
        if (!await JS.InvokeAsync<bool>("confirm", msg)) return;
        await NoteOp(() => Api.MergeActionAsync(source.Id, target.Id, _cts.Token));
    }

    private Task MergeItems((Guid Source, Guid Target) m) => NoteOp(() => Api.MergeActionAsync(m.Source, m.Target, _cts.Token));
    private Task UnmergeItem(Guid id) => NoteOp(() => Api.UnmergeActionAsync(id, _cts.Token));
    private Task DismissDuplicate(Guid otherId) =>
        _editing is null ? Task.CompletedTask : NoteOp(() => Api.DismissDuplicateAsync(_editing.Id, otherId, _cts.Token));

    /// <summary>Runs a merge/unmerge/dismiss call, then refreshes our copy of the notes (and the open dialog, if its note is still visible).</summary>
    private async Task NoteOp(Func<Task<List<ActionItemDto>>> op)
    {
        _editSaving = true;
        _editError = null;
        try
        {
            ApplyActions(await op());
            if (_editing is not null) _editing = _actions.FirstOrDefault(a => a.Id == _editing.Id); // null closes it (note was merged away)
        }
        catch (ApiException ex) { if (_editing is not null) _editError = ex.Message; else _error = ex.Message; }
        catch (OperationCanceledException) { }
        finally { _editSaving = false; }
    }

    private void OnDragOverTarget(string target) { if (_dragId is not null) _dropTarget = target; }

    private void ClearDropTarget(string target) { if (_dropTarget == target) _dropTarget = null; }

    /// <summary>Moves the dragged note to a category (or Uncategorised when null). Optimistic; reverts on failure.</summary>
    private async Task DropOn(Guid? categoryId)
    {
        var id = _dragId;
        EndDrag();
        if (id is null || !CanEdit) return;
        var i = _actions.FindIndex(a => a.Id == id);
        if (i < 0 || _actions[i].CategoryId == categoryId) return;

        var before = _actions[i];
        _actions[i] = before with { CategoryId = categoryId };
        if (categoryId is not null) _activeCategoryId = categoryId;
        try
        {
            var saved = await Api.MoveActionAsync(before.Id, categoryId, _cts.Token);
            var j = _actions.FindIndex(a => a.Id == saved.Id);
            if (j >= 0) _actions[j] = saved;
        }
        catch (ApiException ex)
        {
            var j = _actions.FindIndex(a => a.Id == before.Id);
            if (j >= 0) _actions[j] = before;
            _error = ex.Message;
        }
        catch (OperationCanceledException) { }
    }

    private ActionItemDto? _editing;
    private bool _editSaving;
    private string? _editError;

    private void OpenItem(ActionItemDto item) { _editError = null; _editing = item; }

    private void CloseItem() => _editing = null;

    private async Task SaveItem(UpdateActionItemRequest request)
    {
        if (_editing is null) return;
        _editSaving = true;
        _editError = null;
        try
        {
            var saved = await Api.UpdateActionAsync(_editing.Id, request, _cts.Token);
            var i = _actions.FindIndex(a => a.Id == saved.Id);
            if (i >= 0) _actions[i] = saved;
            _editing = null;
        }
        catch (ApiException ex) { _editError = ex.Message; }
        finally { _editSaving = false; }
    }

    // Filters: "" = no filter. Owner may also be Unassigned.
    private const string Unassigned = "__unassigned__";
    private string _ownerFilter = "", _dueFilter = "", _dupFilter = "";

    private string OwnerFilter { get => _ownerFilter; set { _ownerFilter = value; OnFilterChanged(); } }
    private string DueFilter { get => _dueFilter; set { _dueFilter = value; OnFilterChanged(); } }
    private string DupFilter { get => _dupFilter; set { _dupFilter = value; OnFilterChanged(); } }
    private bool FiltersActive => _ownerFilter != "" || _dueFilter != "" || _dupFilter != "";

    private static bool HasDue(ActionItemDto a) => !string.IsNullOrWhiteSpace(a.Due);

    /// <summary>Distinct party names (case-insensitive) with how many notes each owns.</summary>
    private IEnumerable<(string Name, int Count)> Owners =>
        _actions.Where(a => !string.IsNullOrWhiteSpace(a.Owner))
            .GroupBy(a => a.Owner!.Trim(), StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
            .Select(g => (g.Key, g.Count()));

    private bool Matches(ActionItemDto a)
    {
        bool ownerOk = _ownerFilter switch
        {
            "" => true,
            Unassigned => string.IsNullOrWhiteSpace(a.Owner),
            var name => string.Equals(a.Owner?.Trim(), name, StringComparison.OrdinalIgnoreCase),
        };
        bool dueOk = _dueFilter switch
        {
            "with" => HasDue(a),
            "without" => !HasDue(a),
            _ => true,
        };
        bool dupOk = _dupFilter != "only" || IsPossibleDup(a);
        return ownerOk && dueOk && dupOk;
    }

    private List<ActionItemDto> VisibleUncategorised => _actions.Where(a => a.CategoryId is null && Matches(a)).ToList();

    private void OnFilterChanged()
    {
        // Don't leave a highlight in the source for a note the filter just hid.
        if (_selectedId is Guid id && !_actions.Any(a => a.Id == id && Matches(a))) ClearSelection();
    }

    private void ResetFilters()
    {
        _ownerFilter = _dueFilter = _dupFilter = "";
    }

    private string ProgressText =>
        _run?.Status == ExtractionRunStatus.Queued ? "Extracting… (queued)"
        : _run?.Phase == ExtractionPhase.Consolidating ? "Pass 2 · consolidating…"
        : _run?.WindowCount is > 1 ? $"Pass 1 · window {_run.WindowIndex}/{_run.WindowCount}"
        : "Extracting…";

    private bool IsExtracting => _run?.Status is ExtractionRunStatus.Queued or ExtractionRunStatus.Running;

    // ---- AI model choice ----
    private List<AiModelChoiceDto> _models = [];
    private Guid? _chosenModelId; // null = let the server pick (last used, else default)

    private string ChosenModel
    {
        get => _chosenModelId?.ToString() ?? "";
        set => _chosenModelId = Guid.TryParse(value, out var id) ? id : null;
    }

    private string DefaultModelLabel => _models.FirstOrDefault(m => m.IsDefault) is { } d ? $"Default: {d.Label}" : "Default (server config)";

    private async Task ReloadModels()
    {
        try
        {
            _models = await Api.GetAiModelChoicesAsync(_cts.Token);
            if (_chosenModelId is Guid id && !_models.Any(m => m.Id == id)) _chosenModelId = null;
        }
        catch (ApiException ex) { _error = ex.Message; }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        AiState.Changed += OnAiSettingsChanged;
        try
        {
            _models = await Api.GetAiModelChoicesAsync(_cts.Token);
        }
        catch (ApiException ex) { _error = ex.Message; }
        try
        {
            await RefreshList();
            // Open the most recently updated active workspace; the picker handles the rest.
            var first = _list.FirstOrDefault(w => !w.IsArchived);
            if (first is not null) await LoadWorkspace(first.Id);
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task RefreshList() =>
        _list = await Api.ListWorkspacesAsync(_showArchived, _cts.Token);

    private async Task LoadWorkspace(Guid id)
    {
        _workspace = await Api.GetWorkspaceAsync(id, _cts.Token);
        ApplyActions(_workspace is null ? [] : await Api.GetActionsAsync(id, _cts.Token));
        _run = _workspace is null ? null : await Api.GetLatestRunAsync(id, _cts.Token);
        _categories = _workspace is null ? [] : await Api.GetCategoriesAsync(id, _cts.Token);
        _activeCategoryId = null;
        // Preselect the model this workspace last used (if it still exists).
        _chosenModelId = _run?.AiModelId is Guid last && _models.Any(m => m.Id == last) ? last : null;
        ResetFilters();
        ClearSelection();
        // A run left in flight (e.g. page refreshed mid-extraction) is picked up again.
        if (IsExtracting) _ = PollRun();
    }

    private async Task OnWorkspaceChosen(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var id) || id == _workspace?.Id) return;
        try { await LoadWorkspace(id); }
        catch (ApiException ex) { _error = ex.Message; }
    }

    private async Task OnShowArchivedChanged(ChangeEventArgs e)
    {
        _showArchived = e.Value is true;
        try
        {
            await RefreshList();
            // Hiding archived while one is open: fall back to an active workspace.
            if (!_showArchived && _workspace?.IsArchived == true)
            {
                var next = _list.FirstOrDefault();
                if (next is not null) await LoadWorkspace(next.Id); else ClearWorkspace();
            }
        }
        catch (ApiException ex) { _error = ex.Message; }
    }

    private async Task ToggleArchive()
    {
        if (_workspace is null) return;
        var archive = !_workspace.IsArchived;
        try
        {
            await Api.SetArchivedAsync(_workspace.Id, archive, _cts.Token);
            var id = _workspace.Id;
            await RefreshList();
            if (archive && !_showArchived)
            {
                var next = _list.FirstOrDefault();
                if (next is not null) await LoadWorkspace(next.Id); else ClearWorkspace();
            }
            else
            {
                await LoadWorkspace(id);
            }
        }
        catch (ApiException ex) { _error = ex.Message; }
    }

    private void ClearWorkspace()
    {
        _workspace = null;
        _actions = [];
        _merged = [];
        _categories = [];
        _run = null;
        ClearSelection();
    }

    private void OpenNew() { _replacing = false; _showDialog = true; }

    private void OpenReplace() { _replacing = true; _showDialog = true; }

    private async Task SubmitSource((string Text, SegmentationStrategyKind? Strategy, Guid? ModelId) input)
    {
        _chosenModelId = input.ModelId;
        _saving = true;
        try
        {
            _workspace = !_replacing || _workspace is null
                ? await Api.CreateWorkspaceAsync(new CreateWorkspaceRequest(input.Text, null, input.Strategy), _cts.Token)
                : await Api.ReplaceSourceAsync(_workspace.Id, new ReplaceSourceRequest(input.Text, input.Strategy), _cts.Token);
            _actions = [];
            _merged = [];
            _categories = _workspace is null ? [] : await Api.GetCategoriesAsync(_workspace.Id, _cts.Token);
            _run = null;
            ClearSelection();
            _showDialog = false;
            await RefreshList();
        }
        catch (ApiException ex) { _error = ex.Message; return; }
        finally { _saving = false; }

        await StartExtraction();
    }

    private async Task ConfirmReextract()
    {
        if (_actions.Any(a => !a.IsManual) &&
            !await JS.InvokeAsync<bool>("confirm", "Re-extracting replaces all extracted notes, including any edits you've made to them. Continue?"))
            return;
        await StartExtraction();
    }

    private async Task StartExtraction()
    {
        if (_workspace is null) return;
        try
        {
            _progressHidden = false;
            _run = await Api.StartExtractionAsync(_workspace.Id, _chosenModelId, _cts.Token);
            StateHasChanged();
            await PollRun();
        }
        catch (ApiException ex) { _error = ex.Message; }
        catch (OperationCanceledException) { }
    }

    private async Task PollRun()
    {
        while (IsExtracting && !_cts.IsCancellationRequested)
        {
            await Task.Delay(TimeSpan.FromSeconds(1), _cts.Token);
            _run = await Api.GetRunAsync(_run!.Id, _cts.Token);
            StateHasChanged();
        }
        if (_run?.Status == ExtractionRunStatus.Succeeded && _workspace is not null)
        {
            ApplyActions(await Api.GetActionsAsync(_workspace.Id, _cts.Token));
            // A re-extract can drop the party being filtered on; don't strand the user on an empty view.
            if (_ownerFilter is not ("" or Unassigned) && !Owners.Any(o => string.Equals(o.Name, _ownerFilter, StringComparison.OrdinalIgnoreCase)))
                _ownerFilter = "";
            ClearSelection();
        }
    }

    private void Select(ActionItemDto item)
    {
        if (_selectedId == item.Id) { ClearSelection(); return; }
        _selectedId = item.Id;
        // A note highlights its own passages plus those of every note merged into it.
        _highlights = item.Evidence.Concat(MergedOf(item).SelectMany(m => m.Evidence))
            .Select(e => new HighlightRange(e.Start, e.End, e.MatchQuality)).ToList();
        _scrollPending = true;
    }

    private void ClearSelection()
    {
        _selectedId = null;
        _highlights = [];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollPending) return;
        _scrollPending = false;
        await JS.InvokeVoidAsync("distillforge.scrollToFirstHighlight", "source-text");
    }

    private void OnAiSettingsChanged() => _ = ReloadModels();

    public void Dispose()
    {
        AiState.Changed -= OnAiSettingsChanged;
        _cts.Cancel();
        _cts.Dispose();
    }
}
