<div class="dialog-backdrop" @onclick="BackdropClick">
    <div class="dialog item-dialog" role="dialog" aria-modal="true" aria-labelledby="item-title" @onclick:stopPropagation="true">
        <h2 id="item-title">@(ReadOnly ? "Action item (read-only)" : "Action item")</h2>

        @if (Error is not null)
        {
            <p class="warning error" role="alert">@Error</p>
        }

        <label for="item-title-input">Title</label>
        <input id="item-title-input" type="text" maxlength="@ActionItemValidation.MaxTitle" @bind="_title" @bind:event="oninput" disabled="@(ReadOnly || Busy)" />

        <label for="item-summary">Summary</label>
        <textarea id="item-summary" rows="5" maxlength="@ActionItemValidation.MaxSummary" @bind="_summary" @bind:event="oninput"
                  placeholder="Context someone needs to act on this" disabled="@(ReadOnly || Busy)"></textarea>

        <div class="field-row">
            <div>
                <label for="item-owner">Owner</label>
                <input id="item-owner" type="text" maxlength="@ActionItemValidation.MaxOwner" @bind="_owner" @bind:event="oninput" placeholder="Unassigned" disabled="@(ReadOnly || Busy)" />
            </div>
            <div>
                <label for="item-due">Due</label>
                <input id="item-due" type="text" maxlength="@ActionItemValidation.MaxDue" @bind="_due" @bind:event="oninput" placeholder="e.g. Friday, end of Q3" disabled="@(ReadOnly || Busy)" />
            </div>
        </div>

        <div>
            <span class="field-label" id="colour-label">Colour</span>
            <div class="swatches" role="radiogroup" aria-labelledby="colour-label">
                @foreach (var key in NoteColours.Keys)
                {
                    var selected = key == SelectedColour;
                    <button type="button" role="radio" aria-checked="@selected" class="swatch-choice @(selected ? "chosen" : "")"
                            style="background: var(--note-@key)" title="@SwatchTitle(key)"
                            aria-label="@NoteColours.Label(key)" @onclick="() => ChooseColour(key)" disabled="@(ReadOnly || Busy)"></button>
                }
            </div>
        </div>

        @if (Linked.Count > 0)
        {
            <div class="dup-section">
                <span class="field-label">⚠ Possible duplicates</span>
                @foreach (var o in Linked)
                {
                    <div class="dup-card">
                        <div class="dup-title" title="@o.Summary">@o.Title</div>
                        <div class="note-meta">
                            @if (!string.IsNullOrEmpty(o.Owner)) { <span class="chip">@o.Owner</span> }
                            @if (!string.IsNullOrEmpty(o.Due)) { <span class="chip chip-due">@o.Due</span> }
                            <span class="chip">@CategoryName(o)</span>
                        </div>
                        @if (!ReadOnly)
                        {
                            <div class="dup-actions">
                                <button type="button" class="secondary" disabled="@(IsDirty || Busy)" title="@MergeTip"
                                        @onclick="() => OnMerge.InvokeAsync((o.Id, Item.Id))">Merge it into this note</button>
                                <button type="button" class="secondary" disabled="@(IsDirty || Busy)" title="@MergeTip"
                                        @onclick="() => OnMerge.InvokeAsync((Item.Id, o.Id))">Merge this into it</button>
                                <button type="button" class="link" disabled="@Busy" @onclick="() => OnNotDuplicate.InvokeAsync(o.Id)">Not a duplicate</button>
                            </div>
                        }
                    </div>
                }
                @if (IsDirty && !ReadOnly) { <span class="muted small">Save or reset your edits to enable merging.</span> }
            </div>
        }

        @if (Merged.Count > 0)
        {
            <div class="dup-section">
                <span class="field-label">Merged into this note (@Merged.Count)</span>
                @foreach (var m in Merged)
                {
                    <div class="dup-card">
                        <div class="dup-title" title="@m.Summary">@m.Title</div>
                        @if (m.Evidence.Count > 0)
                        {
                            <details class="evidence">
                                <summary>Its source evidence (@m.Evidence.Count)</summary>
                                <ul>
                                    @foreach (var e in m.Evidence)
                                    {
                                        <li><span class="chip">@e.SegmentLabel</span> “@e.Quote”</li>
                                    }
                                </ul>
                            </details>
                        }
                        @if (!ReadOnly)
                        {
                            <div class="dup-actions">
                                <button type="button" class="secondary" disabled="@(IsDirty || Busy)" title="@MergeTip"
                                        @onclick="() => OnUnmerge.InvokeAsync(m.Id)">Unmerge</button>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (Item.Evidence.Count > 0)
        {
            <details class="evidence">
                <summary>Source evidence (@Item.Evidence.Count)</summary>
                <ul>
                    @foreach (var e in Item.Evidence)
                    {
                        <li><span class="chip">@e.SegmentLabel</span> “@e.Quote”</li>
                    }
                </ul>
            </details>
        }

        <div class="dialog-actions">
            <button type="button" class="secondary" @onclick="OnCancel" disabled="@Busy">@(ReadOnly ? "Close" : "Cancel")</button>
            @if (!ReadOnly)
            {
                <button type="button" class="secondary" @onclick="Reset" disabled="@(!IsDirty || Busy)">Reset</button>
                <button type="button" class="primary" @onclick="Save" disabled="@(!IsDirty || !IsValid || Busy)">@(Busy ? "Saving…" : "Save")</button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ActionItemDto Item { get; set; } = default!;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback<UpdateActionItemRequest> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    /// <summary>Notes flagged as possible duplicates of this one (already resolved to top-level notes).</summary>
    [Parameter] public IReadOnlyList<ActionItemDto> Linked { get; set; } = [];
    /// <summary>Notes merged into this one.</summary>
    [Parameter] public IReadOnlyList<ActionItemDto> Merged { get; set; } = [];
    [Parameter] public IReadOnlyList<CategoryDto> Categories { get; set; } = [];
    /// <summary>(source, target): the source note is merged into the target.</summary>
    [Parameter] public EventCallback<(Guid Source, Guid Target)> OnMerge { get; set; }
    [Parameter] public EventCallback<Guid> OnUnmerge { get; set; }
    [Parameter] public EventCallback<Guid> OnNotDuplicate { get; set; }

    private const string MergeTip = "Merged notes are hidden and follow the note they're merged into. You can unmerge later.";

    private string CategoryName(ActionItemDto o) =>
        o.CategoryId is Guid id && Categories.FirstOrDefault(c => c.Id == id) is { } c ? c.Name : "Uncategorised";

    private string _title = "", _summary = "", _owner = "", _due = "";
    private string? _colour; // null = automatic

    protected override void OnInitialized() => Load();

    private void Load()
    {
        _title = Item.Title;
        _summary = Item.Summary ?? "";
        _owner = Item.Owner ?? "";
        _due = Item.Due ?? "";
        _colour = Item.Colour;
    }

    private static string? Norm(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private string AutoColour => NoteColours.DefaultFor(Norm(_due) is not null);
    private string SelectedColour => _colour ?? AutoColour;

    // Picking the automatic colour clears the override, so the note keeps following its deadline.
    private void ChooseColour(string key) => _colour = key == AutoColour ? null : key;

    private string SwatchTitle(string key) =>
        key == AutoColour ? $"{NoteColours.Label(key)} (default for this note)" : NoteColours.Label(key);

    private bool IsValid => ActionItemValidation.Validate(Build()) is null;

    private bool IsDirty =>
        Norm(_title) != Norm(Item.Title) || Norm(_summary) != Norm(Item.Summary) ||
        Norm(_owner) != Norm(Item.Owner) || Norm(_due) != Norm(Item.Due) || _colour != Item.Colour;

    private UpdateActionItemRequest Build() => new(_title.Trim(), Norm(_summary), Norm(_owner), Norm(_due), _colour);

    private void Reset() => Load();

    private Task Save() => OnSave.InvokeAsync(Build());

    // Don't lose edits to a stray click outside the dialog.
    private Task BackdropClick() => IsDirty || Busy ? Task.CompletedTask : OnCancel.InvokeAsync();
}
