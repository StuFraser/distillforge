@* A wrapper holds two sibling buttons (select + zoom); buttons can't be nested validly. *@
<div class="note-wrap @(Dragging ? "dragging" : "") @(Droppable ? "droppable" : "") @(MergeTarget ? "merge-target" : "")"
     draggable="@(Draggable ? "true" : "false")" @ondragstart="OnDragStart" @ondragend="OnDragEnd"
     @ondragenter="OnDragEnterNote" @ondragenter:stopPropagation="true"
     @ondragover:preventDefault="Droppable" @ondragover:stopPropagation="Droppable"
     @ondragleave="OnDragLeaveNote"
     @oncontextmenu="OnContextMenuAsync" @oncontextmenu:preventDefault="ContextMenuEnabled" @oncontextmenu:stopPropagation="ContextMenuEnabled"
     @ondrop="OnDropNote" @ondrop:preventDefault="Droppable" @ondrop:stopPropagation="Droppable">
    <button type="button" class="note @(Selected ? "selected" : "")" style="--note-colour: var(--note-@ColourKey)" @onclick="OnClick" title="@Item.Summary" aria-pressed="@Selected">
        <span class="note-title">
            @if (PossibleDuplicate) { <span class="dup-flag" title="Possible duplicate: open the note (⤢) to review" aria-label="Possible duplicate">⚠</span> }
            @Item.Title
        </span>
        @if (!string.IsNullOrEmpty(Item.Owner) || !string.IsNullOrEmpty(Item.Due) || LowConfidence || MergedCount > 0)
        {
            <span class="note-meta">
                @if (!string.IsNullOrEmpty(Item.Owner)) { <span class="chip" title="Owner: @Item.Owner">@Item.Owner</span> }
                @if (!string.IsNullOrEmpty(Item.Due)) { <span class="chip chip-due" title="Due: @Item.Due">@Item.Due</span> }
                @if (MergedCount > 0) { <span class="chip chip-merged" title="@MergedCount note(s) merged into this one">+@MergedCount merged</span> }
                @if (LowConfidence) { <span class="chip chip-flag" title="Some evidence couldn't be matched exactly">low confidence</span> }
            </span>
        }
    </button>
    <button type="button" class="note-zoom" @onclick="OnZoom" aria-label="Open details for @Item.Title" title="Open details">⤢</button>
</div>

@code {
    [Parameter, EditorRequired] public ActionItemDto Item { get; set; } = default!;
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public EventCallback OnZoom { get; set; }
    /// <summary>Right-click (or the context-menu key) raised with the pointer position; when the callback isn't bound the browser menu is left alone.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnContextMenu { get; set; }
    [Parameter] public bool Draggable { get; set; }
    [Parameter] public bool Dragging { get; set; }
    [Parameter] public EventCallback OnDragStart { get; set; }
    [Parameter] public EventCallback OnDragEnd { get; set; }
    /// <summary>Another note is being dragged and this one can receive it (merge).</summary>
    [Parameter] public bool Droppable { get; set; }
    [Parameter] public bool MergeTarget { get; set; }
    [Parameter] public bool PossibleDuplicate { get; set; }
    [Parameter] public int MergedCount { get; set; }
    [Parameter] public EventCallback OnDragEnterNote { get; set; }
    [Parameter] public EventCallback OnDragLeaveNote { get; set; }
    [Parameter] public EventCallback OnDropNote { get; set; }

    private bool ContextMenuEnabled => OnContextMenu.HasDelegate;

    private Task OnContextMenuAsync(MouseEventArgs e) => OnContextMenu.InvokeAsync(e);

    /// <summary>The chosen colour, or automatic: yellow when the note has a deadline, otherwise pink.</summary>
    private string ColourKey => Item.Colour is { } c && NoteColours.IsValid(c)
        ? c
        : NoteColours.DefaultFor(!string.IsNullOrWhiteSpace(Item.Due));

    private bool LowConfidence => Item.Evidence.Any(e => e.MatchQuality == MatchQuality.Segment);
}
