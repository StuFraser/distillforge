<button type="button" class="note @(Selected ? "selected" : "")" style="--note-colour: @EffectiveColour" @onclick="OnClick" title="@Item.Summary" aria-pressed="@Selected">
    <span class="note-title">@Item.Title</span>
    @if (!string.IsNullOrEmpty(Item.Owner) || !string.IsNullOrEmpty(Item.Due) || LowConfidence)
    {
        <span class="note-meta">
            @if (!string.IsNullOrEmpty(Item.Owner)) { <span class="chip">@Item.Owner</span> }
            @if (!string.IsNullOrEmpty(Item.Due)) { <span class="chip chip-due">@Item.Due</span> }
            @if (LowConfidence) { <span class="chip chip-flag" title="Some evidence couldn't be matched exactly">low confidence</span> }
        </span>
    }
</button>

@code {
    [Parameter, EditorRequired] public ActionItemDto Item { get; set; } = default!;
    [Parameter] public bool Selected { get; set; }
    /// <summary>Explicit colour (e.g. a category's). When null, notes with a deadline are post-it yellow and the rest pink.</summary>
    [Parameter] public string? Colour { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string EffectiveColour => Colour ?? (string.IsNullOrWhiteSpace(Item.Due) ? "var(--note-uncategorised)" : "var(--note-deadline)");

    private bool LowConfidence => Item.Evidence.Any(e => e.MatchQuality == MatchQuality.Segment);
}
