@* Markdown source viewer. Every visible text run retains its canonical source offset. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="source-text source-markdown" id="@ContainerId">
    @foreach (var block in _blocks)
    {
        switch (block.Kind)
        {
            case MarkdownBlockKind.Heading1:
                <h1>@RenderRange(block.ContentStart, block.ContentEnd)</h1>
                break;
            case MarkdownBlockKind.Heading2:
                <h2>@RenderRange(block.ContentStart, block.ContentEnd)</h2>
                break;
            case MarkdownBlockKind.Heading3:
                <h3>@RenderRange(block.ContentStart, block.ContentEnd)</h3>
                break;
            case MarkdownBlockKind.UnorderedListItem:
                <ul><li>@RenderRange(block.ContentStart, block.ContentEnd)</li></ul>
                break;
            case MarkdownBlockKind.OrderedListItem:
                <ol start="@block.ListStart"><li>@RenderRange(block.ContentStart, block.ContentEnd)</li></ol>
                break;
            case MarkdownBlockKind.BlockQuote:
                <blockquote>@RenderRange(block.ContentStart, block.ContentEnd)</blockquote>
                break;
            case MarkdownBlockKind.Code:
                <pre><code>@RenderRange(block.ContentStart, block.ContentEnd)</code></pre>
                break;
            case MarkdownBlockKind.Table:
                <div class="source-table-wrap">
                    <table>
                        <thead><tr>@foreach (var cell in block.Rows[0].Cells) { <th>@RenderRange(cell.Start, cell.End)</th> }</tr></thead>
                        <tbody>
                            @foreach (var row in block.Rows.Skip(1))
                            {
                                <tr>@foreach (var cell in row.Cells) { <td>@RenderRange(cell.Start, cell.End)</td> }</tr>
                            }
                        </tbody>
                    </table>
                </div>
                break;
            default:
                <p>@RenderRange(block.ContentStart, block.ContentEnd)</p>
                break;
        }
    }
</div>

@if (_selection is { } sel && AllowCreate)
{
    <button type="button" class="selection-action" style="left:@(_x)px; top:@(_y)px"
            @onmousedown:preventDefault="true" @onclick="() => CreateAsync(sel)">＋ New note from selection</button>
}

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter] public IReadOnlyList<HighlightRange> Highlights { get; set; } = [];
    [Parameter] public string ContainerId { get; set; } = "source-text";
    /// <summary>Show the "new note from selection" button when text is selected.</summary>
    [Parameter] public bool AllowCreate { get; set; }
    /// <summary>The user chose to create a note from the selected passage (source offsets, End exclusive).</summary>
    [Parameter] public EventCallback<(int Start, int End)> OnCreateFromSelection { get; set; }

    private IReadOnlyList<TextRun> _runs = [];
    private IReadOnlyList<MarkdownBlock> _blocks = [];
    private string? _lastText;
    private IReadOnlyList<HighlightRange>? _lastHighlights;
    private (int Start, int End)? _selection;
    private double _x, _y;
    private DotNetObjectReference<SourcePane>? _self;
    private IJSObjectReference? _watcher;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_lastText, Text) && ReferenceEquals(_lastHighlights, Highlights)) return;
        _lastText = Text;
        _lastHighlights = Highlights;
        _runs = TextRunBuilder.Build(Text.Length, Highlights);
        _blocks = MarkdownBlocks.Parse(Text);
    }

    private RenderFragment RenderRange(int start, int end) => builder =>
    {
        int sequence = 0;
        foreach (var sourceRun in _runs)
        {
            int runStart = Math.Max(start, sourceRun.Start);
            int runEnd = Math.Min(end, sourceRun.End);
            if (runEnd <= runStart) continue;
            if (sourceRun.Highlight is { } quality)
            {
                builder.OpenElement(sequence++, "mark");
                builder.AddAttribute(sequence++, "data-s", runStart);
                builder.AddAttribute(sequence++, "class", $"hl hl-{quality.ToString().ToLowerInvariant()}");
                if (quality == MatchQuality.Segment)
                    builder.AddAttribute(sequence++, "title", "Low confidence: quote not found, whole segment shown");
            }
            else
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "data-s", runStart);
            }
            builder.AddContent(sequence++, Text.Substring(runStart, runEnd - runStart));
            builder.CloseElement();
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        _watcher = await JS.InvokeAsync<IJSObjectReference>("distillforge.watchSelection", ContainerId, _self);
    }

    [JSInvokable]
    public void OnSelectionChanged(int start, int end, double right, double bottom)
    {
        var next = start >= 0 && end > start ? ((int, int)?)(start, end) : null;
        if (next == _selection && (next is null || (right == _x && bottom == _y))) return;
        _selection = next;
        // Keep the button on screen (it is ~210px wide).
        _x = Math.Max(8, right - 10);
        _y = bottom + 6;
        StateHasChanged();
    }

    private async Task CreateAsync((int Start, int End) sel)
    {
        _selection = null;
        await OnCreateFromSelection.InvokeAsync(sel);
    }

    public async ValueTask DisposeAsync()
    {
        try { if (_watcher is not null) { await _watcher.InvokeVoidAsync("dispose"); await _watcher.DisposeAsync(); } }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }

    private enum MarkdownBlockKind { Paragraph, Heading1, Heading2, Heading3, UnorderedListItem, OrderedListItem, BlockQuote, Code, Table }
    private sealed record MarkdownCell(int Start, int End);
    private sealed record MarkdownTableRow(IReadOnlyList<MarkdownCell> Cells);
    private sealed record MarkdownBlock(MarkdownBlockKind Kind, int ContentStart, int ContentEnd, int ListStart = 1, IReadOnlyList<MarkdownTableRow>? TableRows = null)
    {
        public IReadOnlyList<MarkdownTableRow> Rows => TableRows ?? [];
    }

    private static class MarkdownBlocks
    {
        public static IReadOnlyList<MarkdownBlock> Parse(string text)
        {
            var lines = Lines(text).ToList();
            var blocks = new List<MarkdownBlock>();
            for (int i = 0; i < lines.Count; i++)
            {
                var line = lines[i];
                var value = text[line.Start..line.End];
                if (string.IsNullOrWhiteSpace(value)) continue;
                if (value.TrimStart().StartsWith("```", StringComparison.Ordinal))
                {
                    int contentStart = i + 1 < lines.Count ? lines[i + 1].Start : line.End;
                    int endLine = i + 1;
                    while (endLine < lines.Count && !text[lines[endLine].Start..lines[endLine].End].TrimStart().StartsWith("```", StringComparison.Ordinal)) endLine++;
                    blocks.Add(new MarkdownBlock(MarkdownBlockKind.Code, contentStart, endLine < lines.Count ? lines[endLine].Start : text.Length));
                    i = endLine < lines.Count ? endLine : lines.Count;
                    continue;
                }
                if (i + 1 < lines.Count && IsPipeRow(value) && IsTableSeparator(text[lines[i + 1].Start..lines[i + 1].End]))
                {
                    var rows = new List<MarkdownTableRow> { ParsePipeRow(text, line) };
                    i += 2;
                    while (i < lines.Count && IsPipeRow(text[lines[i].Start..lines[i].End])) { rows.Add(ParsePipeRow(text, lines[i])); i++; }
                    blocks.Add(new MarkdownBlock(MarkdownBlockKind.Table, line.Start, lines[i - 1].End, TableRows: rows));
                    i--;
                    continue;
                }
                int trimmedStart = line.Start;
                while (trimmedStart < line.End && char.IsWhiteSpace(text[trimmedStart])) trimmedStart++;
                var trimmed = text[trimmedStart..line.End];
                int heading = HeadingLevel(trimmed);
                if (heading > 0)
                {
                    int contentStart = trimmedStart + heading;
                    while (contentStart < line.End && text[contentStart] == ' ') contentStart++;
                    blocks.Add(new MarkdownBlock((MarkdownBlockKind)heading, contentStart, TrimEnd(text, contentStart, line.End)));
                }
                else if (trimmed.StartsWith(">", StringComparison.Ordinal))
                {
                    int contentStart = trimmedStart + 1;
                    if (contentStart < line.End && text[contentStart] == ' ') contentStart++;
                    blocks.Add(new MarkdownBlock(MarkdownBlockKind.BlockQuote, contentStart, TrimEnd(text, contentStart, line.End)));
                }
                else if (TryListPrefix(trimmed, out int prefixLength, out int ordinal))
                {
                    int contentStart = trimmedStart + prefixLength;
                    blocks.Add(new MarkdownBlock(ordinal > 0 ? MarkdownBlockKind.OrderedListItem : MarkdownBlockKind.UnorderedListItem, contentStart, TrimEnd(text, contentStart, line.End), ordinal > 0 ? ordinal : 1));
                }
                else blocks.Add(new MarkdownBlock(MarkdownBlockKind.Paragraph, line.Start, TrimEnd(text, line.Start, line.End)));
            }
            return blocks;
        }

        private static IEnumerable<(int Start, int End)> Lines(string text)
        {
            int start = 0;
            while (start <= text.Length)
            {
                int newline = text.IndexOf('\n', start);
                if (newline < 0) { yield return (start, text.Length); yield break; }
                yield return (start, newline);
                start = newline + 1;
            }
        }
        private static int HeadingLevel(string value)
        {
            int hashes = 0;
            while (hashes < value.Length && hashes < 3 && value[hashes] == '#') hashes++;
            return hashes > 0 && hashes < value.Length && value[hashes] == ' ' ? hashes : 0;
        }
        private static bool TryListPrefix(string value, out int prefixLength, out int ordinal)
        {
            prefixLength = 0; ordinal = 0;
            if (value.Length >= 2 && (value[0] is '-' or '*' or '+') && value[1] == ' ') { prefixLength = 2; return true; }
            int digits = 0;
            while (digits < value.Length && char.IsDigit(value[digits])) digits++;
            if (digits > 0 && digits + 1 < value.Length && value[digits] == '.' && value[digits + 1] == ' ' && int.TryParse(value[..digits], out ordinal)) { prefixLength = digits + 2; return true; }
            return false;
        }
        private static bool IsPipeRow(string value) => value.Trim().Length > 0 && value.Contains('|');
        private static bool IsTableSeparator(string value)
        {
            var cells = value.Trim().Trim('|').Split('|', StringSplitOptions.TrimEntries);
            return cells.Length > 0 && cells.All(c => c.Count(ch => ch == '-') >= 3 && c.All(ch => ch is '-' or ':' or ' '));
        }
        private static MarkdownTableRow ParsePipeRow(string text, (int Start, int End) line)
        {
            int start = line.Start, end = line.End;
            while (start < end && char.IsWhiteSpace(text[start])) start++;
            while (end > start && char.IsWhiteSpace(text[end - 1])) end--;
            if (start < end && text[start] == '|') start++;
            if (end > start && text[end - 1] == '|') end--;
            var cells = new List<MarkdownCell>();
            int cellStart = start;
            for (int pos = start; pos <= end; pos++)
            {
                if (pos != end && text[pos] != '|') continue;
                int contentStart = cellStart, contentEnd = pos;
                while (contentStart < contentEnd && char.IsWhiteSpace(text[contentStart])) contentStart++;
                while (contentEnd > contentStart && char.IsWhiteSpace(text[contentEnd - 1])) contentEnd--;
                cells.Add(new MarkdownCell(contentStart, contentEnd));
                cellStart = pos + 1;
            }
            return new MarkdownTableRow(cells);
        }
        private static int TrimEnd(string text, int start, int end)
        {
            while (end > start && char.IsWhiteSpace(text[end - 1])) end--;
            return end;
        }
    }
}
