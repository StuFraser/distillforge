@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject AuthSettingsHolder Auth
@inject NavigationManager Navigation

@if (!Auth.Settings.IsEnabled)
{
    <span class="avatar dev" title="Dev mode: no sign-in (the API is in Auth__Mode=Dev)">DEV</span>
}
else
{
    <AuthorizeView>
        <Authorized>
            <div class="account">
                <button type="button" class="avatar" title="@DisplayName(context.User)" aria-label="Account menu" aria-haspopup="true" aria-expanded="@_open.ToString().ToLowerInvariant()"
                        @onclick="() => _open = !_open">@Initials(DisplayName(context.User))</button>
                @if (_open)
                {
                    <div class="account-backdrop" @onclick="() => _open = false"></div>
                    <div class="account-menu" role="menu">
                        <div class="account-name">@(DisplayName(context.User) ?? "Signed in")</div>
                        <button type="button" role="menuitem" @onclick="SignOut">Sign out</button>
                    </div>
                }
            </div>
        </Authorized>
        <NotAuthorized>
            <button type="button" class="primary" @onclick="SignIn">Sign in</button>
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    private bool _open;

    private void SignIn() => Navigation.NavigateToLogin("authentication/login");

    private void SignOut() => Navigation.NavigateToLogout("authentication/logout", "/");

    /// <summary>External ID reports the name claim as "unknown" when no display name was collected at sign-up; fall back to the email.</summary>
    private static string? DisplayName(System.Security.Claims.ClaimsPrincipal user)
    {
        static bool Usable(string? s) => !string.IsNullOrWhiteSpace(s) && !s.Equals("unknown", StringComparison.OrdinalIgnoreCase);
        var name = user.Identity?.Name;
        if (Usable(name)) return name;
        foreach (var type in new[] { "email", "emails", "preferred_username", "upn" })
            if (user.FindFirst(type)?.Value is { } v && Usable(v)) return v;
        return null;
    }

    private static string Initials(string? name)
    {
        var parts = (name ?? "").Split([' ', '.', '@'], StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch { 0 => "?", 1 => parts[0][..1].ToUpperInvariant(), _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant() };
    }
}
