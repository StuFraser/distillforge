@inherits LayoutComponentBase

<div class="app">
    <header class="app-banner">
        <h1 class="brand">Distill<span>Forge</span></h1>
        <div class="banner-actions">
            <button type="button" class="icon-button" disabled title="Integration settings (AI provider, publishing) – coming soon" aria-label="Settings">⚙</button>
            <button type="button" class="icon-button" disabled title="Share / publish all categories – coming soon" aria-label="Share">⤴</button>
            <button type="button" class="icon-button" disabled title="Help – coming soon" aria-label="Help">?</button>
            <span class="avatar" title="Sign-in coming soon" aria-hidden="true">●</span>
        </div>
    </header>
    <main>
        @Body
    </main>
</div>
