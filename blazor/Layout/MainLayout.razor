@inherits LayoutComponentBase
@inject AiSettingsState AiState

<div class="app">
    <header class="app-banner">
        <h1 class="brand">Distill<span>Forge</span></h1>
        <div class="banner-actions">
            <button type="button" class="icon-button" @onclick="() => _aiSettings = true" title="AI providers and models" aria-label="AI settings">⚙</button>
            <button type="button" class="icon-button" disabled title="Share / publish all categories – coming soon" aria-label="Share">⤴</button>
            <a class="icon-button" href="help" target="_blank" rel="noopener" title="Help (opens in a new tab)" aria-label="Help">?</a>
            <span class="avatar" title="Sign-in coming soon" aria-hidden="true">●</span>
        </div>
    </header>
    <main>
        @Body
    </main>
</div>

@if (_aiSettings)
{
    <AiSettingsDialog OnClose="CloseAiSettings" />
}

@code {
    private bool _aiSettings;

    private void CloseAiSettings()
    {
        _aiSettings = false;
        AiState.NotifyChanged();
    }
}
